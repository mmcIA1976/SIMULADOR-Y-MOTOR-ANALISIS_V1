APP_ENV=development
DATABASE_URL=sqlite:///data/trading_trainer.db
# En servidor usar solo Supabase:
# APP_ENV=production
# SUPABASE_DATABASE_URL=postgresql://USER:PASS@HOST:5432/postgres
TRADING_TRAINER_SECRET=change-me-before-production

# Mapa gratuito de posiciones/liquidaciones publicas de Hyperliquid.
HYPERPERPS_ENABLED=true
HYPERPERPS_TIMEOUT_SECONDS=4
HYPERPERPS_CACHE_TTL_SECONDS=60
HYPERPERPS_MAX_AGE_SECONDS=600
HYPERPERPS_MAX_PRICE_BASIS_PCT=1.5

# Worker autonomo de operaciones. Se ejecuta como servicio separado con:
# python operation_worker.py
OPERATION_WORKER_POLL_SECONDS=10
OPERATION_WORKER_RECONCILE_SECONDS=60
OPERATION_WORKER_HEARTBEAT_SECONDS=60
ORDER_BOOK_OBSERVATION_ENABLED=true
ORDER_BOOK_OBSERVATION_WINDOW_SECONDS=60
ORDER_BOOK_OBSERVATION_PUBLISH_SECONDS=30
OPERATION_WORKER_RECONCILE_OVERLAP_MINUTES=2
OPERATION_WORKER_STARTUP_LOOKBACK_MINUTES=10080
OPERATION_WORKER_STARTUP_MAX_KLINE_PAGES=12
OPERATION_WORKER_RECENT_MAX_KLINE_PAGES=2

# El primer despliegue debe permanecer en observacion. Cambiar a false solo
# despues de verificar heartbeats, precios y reconciliaciones del nuevo servicio.
OPERATION_WORKER_DRY_RUN=true

# false conserva una sola cotizacion terminal por cierre. true guarda tambien
# la ventana densa de velas de salida y consume bastante mas base de datos.
OPERATION_WORKER_PERSIST_EXIT_WINDOW=false

# Mantener true hasta que el servicio worker este desplegado y verificado.
# Despues usar false en el servicio web para que sus sondeos no escriban ticks
# ni procesen TP/SL; el worker pasa a ser el unico propietario de transiciones.
WEB_OPERATION_REFRESH_ENABLED=true
